{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "ui": {
      "root": "ui/",
      "framework": "vite"
    }
  },
  "rewrites": [
    { "source": "/v1/:path*", "destination": "https://llm-router-vzux.onrender.com/v1/:path*" },
    { "source": "/healthz", "destination": "https://llm-router-vzux.onrender.com/healthz" },
    { "source": "/(.*)", "destination": { "service": "ui" } }
  ]
}
